{
    "name": "alan-berger/b2-browser",
    "description": "Secure web browser and player for camera footage in a private Backblaze B2 bucket",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "B2Browser\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "B2Browser\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "e2e": "php tests/e2e/run.php"
    },
    "config": { "sort-packages": true }
}
